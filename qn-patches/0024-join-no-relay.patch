+static void QN_DrawCause (void)
+{
+	const char	*t = QN_JoinCauseText ();
+	int	i, split = 0;
+
+	if (!t)
+		return;
+	for (i = 0; i < 32 && t[i]; i++)
+		if (t[i] == ' ')
+			split = i + 1;
+	if (t[i] && split)
+	{
+		char	head[33];
+
+		for (i = 0; i < split - 1; i++)
+			head[i] = t[i];
+		head[i] = '\0';
+		M_PrintWhite (40, 80, head);
+		M_PrintWhite (40, 92, t + split);
+	}
+	else
+		M_PrintWhite (40, 80, t);
+}

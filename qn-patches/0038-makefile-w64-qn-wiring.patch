@@ -188,10 +197,19 @@
 SYSOBJ_CDA = cd_sdl.o
 SYSOBJ_INPUT = in_sdl.o
 SYSOBJ_GL_VID= gl_vidsdl.o
-SYSOBJ_NET = net_win.o net_wins.o net_wipx.o
+### p2pquake: the landriver's Plane A machinery is shared with the
+### standalone test harness, so its sources live in the project's driver
+### directory (same block as the unix Makefile). vpath finds them.
+QNDIR = ../../../driver
+vpath %.c $(QNDIR)
+CFLAGS += -I$(QNDIR)
+SYSOBJ_NET = net_bsd.o net_udp.o \
+	net_qn.o qn_transport.o qn_frame.o qn_spawn.o qn_stext.o qn_pad.o \

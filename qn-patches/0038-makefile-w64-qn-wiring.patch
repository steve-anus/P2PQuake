--- a/Quake/Makefile.w64
+++ b/Quake/Makefile.w64
@@ -46,6 +46,9 @@
 
 CPUFLAGS=
 LDFLAGS?= -m64 -mwindows -static-libgcc
+WIN_QN_CFLAGS ?=
+WIN_MPG_CFLAGS ?=
+CFLAGS += $(WIN_QN_CFLAGS) $(WIN_MPG_CFLAGS)
 DFLAGS ?=

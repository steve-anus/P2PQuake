+quakespasm.exe: $(addprefix $(OBJDIR)/,$(OBJS)) $(SYSOBJ_RES) | $(OBJDIR)
+	$(LINKER) $(addprefix $(OBJDIR)/,$(OBJS)) $(SYSOBJ_RES) $(LDFLAGS) $(LIBS) $(SDL_LIBS) -o $@
 	$(call do_strip,$@)
 

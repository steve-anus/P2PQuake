 #CFLAGS += $(call check_gcc,-std=gnu11,)
@@ -167,6 +170,12 @@
 
 LIBS = $(COMMON_LIBS) $(NET_LIBS) $(CODEC_LINK) $(CODECLIBS)
 
+# p2pquake: named-pipe DACL + CSPRNG imports
+LIBS += -lbcrypt -ladvapi32
+# SDL2 (static from the official devel archive) drags its full win32 dep set
+LIBS += -lshlwapi -lole32 -loleaut32 -lsetupapi -lversion -limm32 \
+        -luuid -lwinmm -ldinput8 -luser32 -lgdi32 -lkernel32
+
 # ---------------------------
 # objects

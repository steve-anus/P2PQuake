 GLOBJS = \
 	gl_refrag.o \
@@ -263,16 +281,20 @@
 
 .PHONY:	clean debug release
 
+OBJDIR ?= build-w64
 DEFAULT_TARGET = quakespasm.exe
 all: $(DEFAULT_TARGET)
 
-%.o:	%.c
+$(OBJDIR):
+	mkdir -p $(OBJDIR)
+
+$(OBJDIR)/%.o:	%.c | $(OBJDIR)
 	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
 %.res:	../Windows/%.rc
 	$(WINDRES) -I../Windows --output-format=coff --target=pe-x86-64 -o $@ $<
 

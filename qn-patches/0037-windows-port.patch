+	if (q_snprintf (qn_win_gamedata_path, sizeof (qn_win_gamedata_path),
+		"%.*sgamedata.sha256", (int) (n - t), prog)
+		>= (int) sizeof (qn_win_gamedata_path))
+	{
+		qn_note ("gamedata manifest path too long");
+		return false;
